{
  "name": "sanity-plugin-sortable-tree",
  "version": "2.3.0",
  "description": "Sortable tree input for Sanity arrays",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/dennisregalado/sanity-plugin-sortable-tree#readme",
  "bugs": {
    "url": "https://github.com/dennisregalado/sanity-plugin-sortable-tree/issues"
  },
  "license": "MIT",
  "author": "Dennis Regalado <dennis@baggy.studio>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisregalado/sanity-plugin-sortable-tree.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "changeset": "changeset",
    "dev": "node dev/start.mjs",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "perf": "node --no-warnings dev/e2e/perf.mjs",
    "prepublishOnly": "npm run build",
    "screenshots": "node --no-warnings dev/e2e/screenshots.mjs",
    "test": "vitest run",
    "test:e2e": "node --no-warnings dev/e2e/interactions.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.3",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@sanity/util": "^6.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/icons": "^5.4.0",
    "@sanity/pkg-utils": "^13.0.18",
    "@sanity/plugin-kit": "^10.1.1",
    "@sanity/ui": "^4.4.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.23.0",
    "styled-components": "^6.4.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@sanity/icons": "^5",
    "@sanity/ui": "^4",
    "react": "^19.2",
    "sanity": "^6"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
