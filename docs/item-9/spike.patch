+
+/** What a native tree row needs from the tree, which owns the item's real path in the tree */
+export interface TreeRowActions {
+  /** Only root rows host the edit dialog; nested items open through their root ancestor's dialog */
+  isRoot: boolean
+  onOpen: () => void
+  onRemove: () => void
+  /** Inserts siblings next to the item (duplicate, insert before/after) */
+  onInsert: (items: unknown[], position: 'before' | 'after') => void
+}
+
+export const TreeRowContext = createContext<TreeRowActions | null>(null)
+
+const NO_SORT = new WeakMap<object, unknown>()
+
+/** The array type without the Studio's own drag handle (the tree draws its own) */
+function withoutSortable<T extends {options?: unknown}>(type: T): T {
+  let next = NO_SORT.get(type) as T | undefined
+  if (!next) {
+    next = {...type, options: {...(type.options as object), sortable: false}}
+    NO_SORT.set(type, next)
+  }
+  return next
+}
+
+/** The Studio's own item (card, presence, validation, menu, edit dialog), with the tree's actions */
+function TreeNativeItem(props: ItemProps) {
+  const row = useContext(TreeRowContext)
+  if (!row || !('parentSchemaType' in props) || !('onInsert' in props)) {
+    return props.renderDefault(props)
+  }
+  const objectProps = props as ObjectItemProps
+  return objectProps.renderDefault({
+    ...objectProps,
+    parentSchemaType: withoutSortable(objectProps.parentSchemaType),
+    open: row.isRoot && objectProps.open,
+    onOpen: row.onOpen,
+    onRemove: row.onRemove,
+    onInsert: (event: Parameters<ObjectItemProps['onInsert']>[0]) =>
+      row.onInsert(event.items, event.position),
+  })
+}
+
+/** An array member rendered as a real Studio array item */
+export const NativeMemberItem = memo(function NativeMemberItem({
+  member,
+  callbacks,
+}: MemberPreviewProps) {
+  const nativeMember = useMemo(
+    () => ({
+      ...member,
+      item: {
+        ...member.item,
+        schemaType: {
+          ...member.item.schemaType,
+          components: {
+            ...member.item.schemaType.components,
+            item: TreeNativeItem,
+            preview: TreeItemPreview,
+          },
+        },
+      },
+    }),
+    [member],
+  )
+
+  return <ArrayOfObjectsItem member={nativeMember} {...callbacks} />
+})
